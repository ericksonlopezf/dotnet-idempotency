# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source and documentation files
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.snk binary
*.pfx binary
*.ico binary
