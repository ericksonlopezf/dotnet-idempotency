<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EricksonLopez.Idempotency.MySql</RootNamespace>
    <AssemblyName>EricksonLopez.Idempotency.MySql</AssemblyName>
    <Description>MySQL storage provider for EricksonLopez.Idempotency using Dapper, MySqlConnector, and raw SQL.</Description>
    <PackageTags>$(CommonPackageTags);mysql;mysqlconnector;dapper;sql;relational-database;database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Idempotency.Abstractions\EricksonLopez.Idempotency.Abstractions.csproj" />
    <ProjectReference Include="..\EricksonLopez.Idempotency\EricksonLopez.Idempotency.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Idempotency.MySql.Tests" />
  </ItemGroup>

</Project>
