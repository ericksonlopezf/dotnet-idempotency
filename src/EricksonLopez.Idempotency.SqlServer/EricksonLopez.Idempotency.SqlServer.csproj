<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>EricksonLopez.Idempotency.SqlServer</RootNamespace>
    <AssemblyName>EricksonLopez.Idempotency.SqlServer</AssemblyName>
    <Description>Microsoft SQL Server storage provider for EricksonLopez.Idempotency using Dapper and raw SQL.</Description>
    <PackageTags>$(CommonPackageTags);sqlserver;mssql;t-sql;sqlclient;dapper;sql;relational-database;database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Idempotency.Abstractions\EricksonLopez.Idempotency.Abstractions.csproj" />
    <ProjectReference Include="..\EricksonLopez.Idempotency\EricksonLopez.Idempotency.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Idempotency.SqlServer.Tests" />
  </ItemGroup>

</Project>
